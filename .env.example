# Admin key for /admin page and /api/admin/refresh endpoint
# Set a long random string (e.g. openssl rand -hex 32)
ADMIN_KEY=your-secret-admin-key-here

# TfNSW API key — leave blank until you have one
# Once set, live patronage/traffic data will be fetched from the TfNSW Open Data API
TFNSW_API_KEY=
