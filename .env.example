# Admin key for /admin page and /api/admin/refresh endpoint
# Set a long random string (e.g. openssl rand -hex 32)
ADMIN_KEY=your-secret-admin-key-here

# Auth mode
# development = local header-based identity
# proxy       = trusted reverse-proxy identity headers
AUTH_MODE=development

# Repository drivers
# sqlite   = local/dev
# postgres = shared multi-user production
DATA_REPOSITORY_DRIVER=sqlite
PROJECTS_REPOSITORY_DRIVER=sqlite

# PostgreSQL connection settings (required when either driver is postgres)
DATABASE_URL=
# true | false | allow-self-signed
POSTGRES_SSL=false

# Refresh worker configuration
# In production, prefer a dedicated worker process: npm run worker:refresh
RUN_INLINE_REFRESH_WORKER=false
REFRESH_WORKER_POLL_MS=5000

# TfNSW API key — enables live Traffic Volume Counts API fetches
# Patronage is linked from official TfNSW Tableau views; crash summaries come from the NSW Crash Data workbook
TFNSW_API_KEY=

# OpenRouteService API key — enables indicative car/cycle/walk commute benchmarking
OPENROUTESERVICE_API_KEY=
